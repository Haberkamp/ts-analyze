{
  "name": "ts-analyze",
  "version": "0.3.0",
  "description": "Find the order to migrate a JavaScript project to TypeScript, show circular dependencies, and fail when TypeScript imports JavaScript.",
  "type": "module",
  "bin": {
    "ts-analyze": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
